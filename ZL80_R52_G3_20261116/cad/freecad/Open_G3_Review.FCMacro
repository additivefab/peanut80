# FreeCAD macro: imports generated STEP parts and exact placement as independent features.
# This is a review assembly, not a sketch/history/constraint reconstruction.
import os, json, re, datetime
import FreeCAD as App
import Part
from PySide import QtWidgets
from pathlib import Path
root = Path(QtWidgets.QFileDialog.getExistingDirectory(None, '选择含START_HERE.html的G3完整包目录'))
if not (root/'cad/instances.json').exists():
    raise RuntimeError('未选择正确G3根目录；需要cad/instances.json')
rows=json.loads((root/'cad/instances.json').read_text(encoding='utf-8'))
doc=App.newDocument('ZL80_G3_Review');cache={}
for i,r in enumerate(rows):
    if r['group'] in ('reference','enclosure'): continue
    pid=r['part']
    if pid not in cache: cache[pid]=Part.read(str(root/'cad/parts'/f'{pid}.step'))
    obj=doc.addObject('Part::Feature', re.sub('[^A-Za-z0-9_]','_',f'P{i:03}_{r["name"]}'))
    obj.Label=pid+' | '+r['name'];obj.Shape=cache[pid].copy()
    rotation=App.Rotation()
    if r['rotation']:
        axis,angle=r['rotation'];rotation=App.Rotation(App.Vector(*axis),angle)
    obj.Placement=App.Placement(App.Vector(*r['position']),rotation)
    obj.addProperty('App::PropertyString','SourceSTEP','Provenance');obj.SourceSTEP='cad/parts/'+pid+'.step'
    obj.addProperty('App::PropertyString','ReleaseStatus','Provenance');obj.ReleaseStatus='REVIEW_NOT_FOR_PRODUCTION'
doc.recompute()
try:
    import FreeCADGui as Gui
    Gui.activeDocument().activeView().viewAxonometric();Gui.activeDocument().activeView().fitAll()
except Exception: pass
out=root/'cad/freecad'/('ZL80_G3_Core_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S')+'.FCStd')
doc.saveAs(str(out))
App.Console.PrintMessage('已生成本机审查工程：'+str(out)+'\n请测量辊径20mm与辊距84mm；原生实跑验证须由本机记录。\n')
